<?xml version="1.0" encoding="utf-8" ?>
<Configuration>
    <ViewDefinitions>
        <View>
            <Name>CCSession</Name>
            <ViewSelectedBy>
                <TypeName>CCSession</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <!-- AutoSize makes PowerShell buffer every row and size each
                     column to its widest value (header included), instead of
                     the old fixed widths that amputated long Folder paths,
                     custom Session titles, and the UUID File column. This is
                     the format-layer equivalent of Format-Table -AutoSize, so
                     the script still emits real CCSession objects and the
                     pipeline (e.g. | Where-Object Size -lt 5) keeps working.
                     A console narrower than the table still makes PowerShell
                     cut or drop the rightmost columns. -->
                <AutoSize/>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Index</Label>
                        <Alignment>Right</Alignment>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Folder</Label>
                        <Alignment>Left</Alignment>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Session</Label>
                        <Alignment>Left</Alignment>
                    </TableColumnHeader>
                    <!-- Index deliberately repeated here. You pick a session by
                         reading Session/Modified/Size on the right, and on a
                         long table tracking back to the far-left number is error
                         prone when the next thing you type is -Delete <n>. -->
                    <TableColumnHeader>
                        <Label>Index</Label>
                        <Alignment>Right</Alignment>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Modified</Label>
                        <Alignment>Left</Alignment>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Size</Label>
                        <Alignment>Right</Alignment>
                    </TableColumnHeader>
                    <!-- Tokens in context as of the last reply. Decimal k, not
                         KiB, because context windows are quoted as 200k / 1M. -->
                    <TableColumnHeader>
                        <Label>Context</Label>
                        <Alignment>Right</Alignment>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Model</Label>
                        <Alignment>Left</Alignment>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>File</Label>
                        <Alignment>Left</Alignment>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>Index</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Folder</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Session</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Index</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>$_.Modified.ToString('yyyy-MM-dd HH:mm:ss')</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <!-- Size is the transcript file alone, in KB. The
                                     unit is printed in the cell because a bare
                                     number next to Context read as anything. -->
                                <ScriptBlock>'{0:N0} KB' -f $_.Size</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <!-- Half away from zero (2,500 shows 3k, not banker's 2k);
                                     under 1,000 there is nothing to round to. This is XML,
                                     so the '<1k' label is written &lt;1k: a bare '<' made
                                     Update-FormatData reject the whole file. -->
                                <ScriptBlock>if ($null -ne $_.Context) { if ($_.Context -lt 1000) { '&lt;1k' } else { '{0}k' -f [math]::Round($_.Context / 1000, [MidpointRounding]::AwayFromZero) } }</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <!-- The object keeps the raw API name for filtering
                                     ('claude-opus-5-5'); the view shortens it to
                                     'opus 5.5'. The 'claude-' prefix and an 8-digit
                                     date suffix are always dropped; a name that is
                                     not then family-major[-minor] is shown as is. -->
                                <ScriptBlock>
                                    $m = $_.Model -replace '^claude-', '' -replace '-\d{8}$', ''
                                    if ($m -match '^([a-z]+)-(\d+)(?:-(\d+))?$') {
                                        $Matches[1] + ' ' + $Matches[2] + $(if ($Matches[3]) { '.' + $Matches[3] })
                                    } else { $m }
                                </ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>File</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <!-- -Orphans rows. Index prints as o# so it can never be mistaken for
             a session index: -Delete o3 without -Orphans is refused. -->
        <View>
            <Name>CCOrphan</Name>
            <ViewSelectedBy>
                <TypeName>CCOrphan</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <AutoSize/>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Index</Label>
                        <Alignment>Right</Alignment>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>State</Label>
                        <Alignment>Left</Alignment>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Kind</Label>
                        <Alignment>Left</Alignment>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Folder</Label>
                        <Alignment>Left</Alignment>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Files</Label>
                        <Alignment>Right</Alignment>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Size</Label>
                        <Alignment>Right</Alignment>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Last write</Label>
                        <Alignment>Left</Alignment>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Why</Label>
                        <Alignment>Left</Alignment>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Path</Label>
                        <Alignment>Left</Alignment>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <ScriptBlock>'o' + $_.Index</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>State</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Kind</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Folder</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Files</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>'{0:N0} KB' -f $_.Size</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>if ($_.LastWrite) { $_.LastWrite.ToString('yyyy-MM-dd') }</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Why</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Path</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
    </ViewDefinitions>
</Configuration>
